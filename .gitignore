# macOS
.DS_Store

# Xcode
build/
DerivedData/
# XcodeGen で project.yml から生成するためコミットしない
*.xcodeproj/*
# ただし Package.resolved だけは依存 revision 固定のため追跡する。
# 親ディレクトリを段階的に再包含しないと Git が中まで降りないので、この順序が必要。
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcodeproj/project.xcworkspace/xcshareddata/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
*.xcuserstate
*.xcscmblueprint
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# Models (large, downloaded at runtime)
Models/
*.mlmodelc
*.gguf
*.safetensors

# Environment / secrets
.env
.env.local
.env*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log

# Local docs (personal notes, not for git)
local_docs/

# Claude Code の worktree 置き場（EnterWorktree が作る。中身は本体で追跡しない）
.claude/worktrees/
ai_docs/*
!ai_docs/north-star.md

# 説明書サイト（VitePress）
node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
